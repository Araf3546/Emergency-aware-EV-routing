 <node id="13321630034" visible="true" version="6" changeset="181573483" timestamp="2026-04-20T09:47:04Z" user="Jota Cartas" uid="4828561" lat="41.1547370" lon="-8.6123483">
  <tag k="artist_name" v="Rogério Azevedo"/>
  <tag k="artwork_type" v="bust"/>
  <tag k="description" v="Pires Veloso (n.1926 f.2014). Enquanto governador militar do Norte, Pires Veloso foi um dos principais intervenientes no contragolpe militar do 25 de novembro, que pôs fim ao &quot;Verão Quente&quot; de 1975, ficou popularmente conhecido por &quot;Vice-Rei do Norte&quot;."/>
  <tag k="inscription" v="&quot;Uma homenagem à liberdade&quot; (placa em bronze desaparecida, situava-se do lado direito da base)"/>
  <tag k="material" v="bronze"/>
  <tag k="name" v="General Pires Veloso"/>
  <tag k="ref:cmp:map" v="109"/>
  <tag k="source:url" v="https://cms.porto.pt/documents/Mapa_de_Arte_Publica_Porto_Rotas.pdf"/>
  <tag k="tourism" v="artwork"/>
 </node>
