  <tag k="description" v="Pequena capela de acesso interdito ao público, apenas visível do exterior através de uma porta de vidro, acessível pelo lanço do meio da escadaria, a capela fica por baixo da igreja devido ao desnível da rua."/>
  <tag k="description:en" v="A small chapel with no public access, only visible from the outside through a glass door, accessible via the middle section of the staircase, the chapel is below the church due to the unevenness of the street."/>
  <tag k="layer" v="-1"/>
  <tag k="name" v="Capela da Senhora da Lapa"/>
  <tag k="name:en" v="Chapel of Senhora da Lapa"/>
  <tag k="religion" v="christian"/>
  <tag k="wikimedia_commons" v="Category:Capela de Nossa Senhora da Lapa (Igreja dos Clérigos)"/>
 </node>
